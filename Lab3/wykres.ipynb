import matplotlib.pyplot as pl
# Dane do wykresu
x = [2, 4, 3]  # Zakres funkcji (1 - podstawowe, 5 - zaawansowane)
y = [2, 4, 3]  # Ocena użytkowników (1 - niska, 5 - wysoka)
labels = ['GardenTags', 'PictureThis', 'PlantSnap']

# Stworzenie wykresu
plt.figure(figsize=(6,6))
plt.scatter(x, y, color='black', s=100)

# Dodanie etykiet dla każdego punktu
for i, label in enumerate(labels):
    plt.text(x[i] + 0.1, y[i], label, fontsize=10)

# Oznaczenie osi
plt.xlabel('Zakres funkcji')
plt.ylabel('Ocena użytkowników')

# Granice osi
plt.xlim(1, 5)
plt.ylim(1, 5)

# Wyłączenie siatki i dodatkowych elementów
plt.grid(False)

# Wyświetlenie prostego wykresu
plt.show()
